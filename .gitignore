# ─── SECRETS — never commit ────────────────────────────────────────────────────
# Live server keys: API_KEY_SALT, AUTH_TOKEN_KEY, UID_ENCRYPTION_KEY, DB password.
deploy/secrets.env
# Rendered from blml.conf.template by gen-config.sh; contains those same secrets.
deploy/blml.conf
# Android signing. Losing OR leaking this key is unrecoverable for a published app.
*.keystore
*.jks
keystore.properties
# Firebase configs (per-developer, contain project keys).
**/google-services.json
**/GoogleService-Info.plist

# ─── machine-local ─────────────────────────────────────────────────────────────
local.properties
.DS_Store

# ─── build output / dependencies ───────────────────────────────────────────────
build/
build-device/
DerivedData/
*.xcuserdatastate
xcuserdata/
Pods/
node_modules/
.gradle/

# ─── generated ─────────────────────────────────────────────────────────────────
brand/screenshots/*.png
!brand/screenshots/.gitkeep
# Only the screenshots used by README.md are published; everything else in
# this folder is working material and may contain personal data. These five
# are captured from throwaway demo accounts, never from the real server's
# conversations.
!brand/screenshots/ios-splash.png
!brand/screenshots/ios-welcome.png
!brand/screenshots/ios-chats.png
!brand/screenshots/ios-conversation.png
!brand/screenshots/android-splash.png
!brand/screenshots/android-welcome.png
!brand/screenshots/android-chats.png
!brand/screenshots/android-conversation.png
!brand/screenshots/web-conversation.png

# App Store Connect API key identifiers (the .p8 itself lives outside the repo)
ios/.testflight.env

# App Store listing screenshots, regenerated from the demo account
brand/appstore/

# Built APKs staged for the /android download page live on the server, not in git.
deploy/downloads/*.apk
