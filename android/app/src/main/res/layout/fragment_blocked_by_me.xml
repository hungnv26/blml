<?xml version="1.0" encoding="utf-8"?>
<!-- Replaces the composer in a chat the user has blocked: "You blocked this contact. UNBLOCK" -->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/blockedByMePanel"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:paddingStart="12sp"
    android:visibility="gone"
    tools:ignore="RtlSymmetry">

    <TextView
        style="@style/textPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignEnd="@id/blockedSeparator"
        android:text="@string/you_blocked_contact"
        android:layout_centerVertical="true" />

    <View
        android:id="@+id/blockedSeparator"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_centerVertical="true"
        android:layout_alignStart="@id/unblockButton"
        android:background="@color/colorBorderGray"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp" />

    <Button
        style="@style/Widget.AppCompat.Button.Borderless.Colored"
        android:id="@+id/unblockButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:text="@string/action_unblock" />

</RelativeLayout>
