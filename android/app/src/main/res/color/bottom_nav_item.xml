<?xml version="1.0" encoding="utf-8"?>
<!-- Icon + label tint for the bottom navigation. Set explicitly because the
     theme's default resolved to a dark tint over a dark bar, making the
     unselected tabs invisible. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/colorBottomNavSelected" android:state_checked="true" />
    <item android:color="@color/colorBottomNavUnselected" />
</selector>
