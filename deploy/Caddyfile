# TLS front end for BLML. Caddy obtains and renews a Let's Encrypt certificate
# for BLML_DOMAIN on its own; there is no certbot step and no renewal cron.
#
# Websockets need no special handling here — reverse_proxy upgrades them.

{
	email {$ACME_EMAIL}
}

{$BLML_DOMAIN} {
	encode zstd gzip

	# Uploads are the largest thing clients send. The server enforces its own
	# limit from blml.conf; this only stops Caddy buffering something absurd.
	request_body {
		max_size 100MB
	}

	# The admin dashboard is deliberately not proxied. It stays on loopback and
	# is reached over an SSH tunnel:  ssh -L 6061:localhost:6061 <vps>
	reverse_proxy blml:6060 {
		# Long-lived websockets: do not cut an idle chat connection.
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# The server sends max-age=39600 (11 hours) for everything, and the bundle
	# filenames carry no content hash — so after a deploy people keep running
	# the previous CSS and JS for up to half a day, with no way to tell that is
	# what they are looking at. It made a fixed theme look unfixed.
	#
	# "no-cache" does not mean "do not store": the file is still cached, the
	# browser just revalidates before using it. With ETag/Last-Modified already
	# present that is a 304 and no body transfer, so the cost is one small
	# round trip per asset.
	# `defer` matters: without it Caddy writes the header before proxying and the
	# upstream then adds its own, leaving two conflicting Cache-Control values on
	# the same response. Deferring applies it after the proxy has replied, so it
	# replaces rather than duplicates.
	@code path *.js *.css *.json /
	header @code {
		Cache-Control "no-cache"
		defer
	}

	# Serve the privacy policy at a clean /privacy as well as /privacy.html.
	# App Store Connect and the Play Console both want a bare URL, and a link
	# with a file extension in it looks like an afterthought.
	rewrite /privacy /privacy.html

	# Media is immutable in practice: wallpapers and icons change name when they
	# change, and uploads are content-addressed. Let those cache properly.
	@media path *.png *.jpg *.jpeg *.svg *.webp *.woff2 *.mp3
	header @media {
		Cache-Control "public, max-age=604800"
		defer
	}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
