# Copy to secrets.env and fill with real values, then run ./gen-config.sh
#
# Generate each with:
#   API_KEY_SALT / AUTH_TOKEN_KEY :  openssl rand -base64 32
#   UID_ENCRYPTION_KEY            :  openssl rand -base64 16
#   POSTGRES_PASSWORD             :  openssl rand -base64 24
#
# WARNING: UID_ENCRYPTION_KEY must NEVER change after the server has live users —
# it derives every user ID. Rotating it corrupts all accounts.
API_KEY_SALT=
AUTH_TOKEN_KEY=
UID_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# Invite code required at signup. Leave blank to allow open registration.
REGISTRATION_CODE=

# Email verification. true = users must confirm their email at signup.
EMAIL_VERIFICATION=false
# Accounts created before this date (RFC 3339, UTC) can still sign in without a
# verified email; set it to the moment you switch verification on so existing
# members are not locked out. Blank = every account must verify.
EMAIL_REQUIRED_SINCE=
SMTP_SERVER=
SMTP_PORT=587
SMTP_LOGIN=
SMTP_PASSWORD=
SMTP_SENDER='"BLML" <noreply@example.com>'

# ── Voice/video calls ─────────────────────────────────────────────────────────
# STUN alone is enough when at least one party is not behind symmetric NAT.
# Add a TURN relay (coturn, or a hosted one) for calls that always connect.
WEBRTC_ENABLED=true
STUN_URL=stun:stun.l.google.com:19302
# On the VPS, coturn runs alongside the server: set TURN_URL to
#   turn:chat.blml.app:3478
# and invent a username/password here — they are shared credentials handed to
# clients in the ICE config, not per-user logins.
TURN_URL=
TURN_USER=
TURN_PASSWORD=

# ── Phone numbers (address-book sync) ─────────────────────────────────────────
# With TWILIO_SID/TWILIO_TOKEN blank the server sends no SMS and confirms a
# number as soon as it is entered; a confirmed number belongs to one account.
# Fill in Twilio credentials to verify numbers by SMS instead.
PHONE_VERIFICATION=true
TWILIO_SID=
TWILIO_TOKEN=

# ── Sign in with Google / Apple ───────────────────────────────────────────────
# Needs the providers enabled in the Firebase console (same project as FCM).
# FIREBASE_SIGNIN_OPEN=true lets these sign-ups in without REGISTRATION_CODE.
FIREBASE_SIGNIN=true
FIREBASE_SIGNIN_OPEN=true

# ── Admin dashboard ───────────────────────────────────────────────────────────
# Bearer token for the operator dashboard on http://localhost:6061/?token=...
# The service is bound to loopback; generate with: openssl rand -hex 16
ADMIN_TOKEN=

# ── Production (VPS) ─────────────────────────────────────────────────────────
# Only needed for the deployment on the server; ignored by a local checkout.
BLML_DOMAIN=chat.blml.app
ACME_EMAIL=you@example.com

# REQUIRED IN PRODUCTION. Binds the app to loopback so only Caddy can reach it.
# Leave unset locally, where phones on the same wifi connect to it directly.
#
# Miss this on a public box and the chat API is published on 0.0.0.0:6060 in
# cleartext — every client bypasses TLS if it connects there, and the whole API
# sits outside Caddy. Docker writes its own iptables rules ahead of ufw, so
# `ufw status` will still look correct while the port is wide open. The only
# honest check is from another machine:
#     nc -z <server-ip> 6060   # must fail
BLML_BIND=127.0.0.1

# TURN external address. Left blank, gen-config.sh asks api.ipify.org, which is
# right for a normal VPS. Set it explicitly if the box is behind another NAT.
TURN_EXTERNAL_IP=
